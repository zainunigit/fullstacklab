const publicUser = ({ passwordHash, salt, ...u }) => u;
const hashPw = (pw, salt = crypto.randomBytes(16).toString('hex')) => ({
  salt,
  passwordHash: crypto.scryptSync(pw, salt, 64).toString('hex'),
});
const checkPw = (pw, user) =>
  crypto.timingSafeEqual(
    Buffer.from(hashPw(pw, user.salt).passwordHash, 'hex'),
    Buffer.from(user.passwordHash, 'hex')
  );
const emailTaken = (addr, exceptId) => users.items.some((u) => u.email === addr && u.id !== exceptId);

route('POST', '/signup', ({ body }) => {
  const data = validate({ name: str(true), email: email(true), password }, body, false);
  if (body.confirmPassword !== data.password) throw new HttpError(400, 'confirmPassword does not match password');
  if (emailTaken(data.email)) throw new HttpError(409, 'Email already registered');
  const { password: pw, ...profile } = data;
  return [201, publicUser(users.insert({ ...profile, ...hashPw(pw) }))];
});

route('POST', '/login', ({ body }) => {
  const data = validate({ email: email(true), password: { required: true, parse: (v) => {
    if (typeof v !== 'string' || !v) throw 'is required';
    return v;
  } } }, body, false);
  const user = users.items.find((u) => u.email === data.email);
  if (!user || !checkPw(data.password, user)) throw new HttpError(401, 'Invalid email or password');
  return [200, { message: 'Login successful', remember: body.remember === true, user: publicUser(user) }];
});

route('GET', '/users', () => [200, users.items.map(publicUser)]);
route('GET', '/users/:id', ({ params }) => {
  const user = users.find(parseId(params.id));
  if (!user) throw new HttpError(404, 'user not found');
  return [200, publicUser(user)];
});
route('PATCH', '/users/:id', ({ params, body }) => {
  const user = users.find(parseId(params.id));
  if (!user) throw new HttpError(404, 'user not found');
  const data = validate({ name: str(), email: email(), password: { ...password, required: false } }, body, true);
  if (data.email && emailTaken(data.email, user.id)) throw new HttpError(409, 'Email already registered');
  const { id, createdAt, updatedAt, ...rest } = user;
  const { password: pw, ...profile } = data;
  return [200, publicUser(users.replace(id, { ...rest, ...profile, ...(pw ? hashPw(pw) : {}) }))];
});
route('DELETE', '/users/:id', ({ params }) => {
  const user = users.find(parseId(params.id));
  if (!user) throw new HttpError(404, 'user not found');
  users.remove(user.id);
  carts.removeWhere((c) => c.userId === user.id);
  return [200, { deleted: publicUser(user) }];
});

const cartFields = {
  userId: ref(true, 'users'),
  productId: ref(true, 'products'),
  quantity: num(false, 1, 99, { integer: true, def: 1 }),
  size: num(false, 4, 15, { def: 8 }),
};

function cartView(userId) {
  const lines = carts.items
    .filter((c) => c.userId === userId)
    .map((c) => {
      const p = products.find(c.productId);
      return {
        id: c.id,
        productId: c.productId,
        name: p.name,
        category: p.category,
        emoji: p.emoji,
        price: p.price,
        size: c.size,
        quantity: c.quantity,
        lineTotal: (cents(p.price) * c.quantity) / 100,
      };
    });
  return {
    userId,
    items: lines,
    itemCount: lines.reduce((n, l) => n + l.quantity, 0),
    ...totals(lines),
  };
}

function cartUserId(query) {
  const raw = query.get('userId');
  if (raw === null) throw new HttpError(400, 'userId query parameter is required');
  const id = parseId(raw);
  if (!users.find(id)) throw new HttpError(404, `user ${id} not found`);
  return id;
}

route('GET', '/cart', ({ query }) => [200, cartView(cartUserId(query))]);

route('POST', '/cart', ({ body }) => {
  const d = validate(cartFields, body, false);
  const same = carts.items.find((c) => c.userId === d.userId && c.productId === d.productId && c.size === d.size);
  if (same) {
    if (same.quantity + d.quantity > 99) throw new HttpError(400, 'quantity cannot exceed 99');
    const { id, createdAt, updatedAt, ...rest } = same;
    carts.replace(id, { ...rest, quantity: same.quantity + d.quantity });
    return [200, cartView(d.userId)];
  }
  carts.insert(d);
  return [201, cartView(d.userId)];
});

route('PATCH', '/cart/:id', ({ params, body }) => {
  const line = carts.find(parseId(params.id));
  if (!line) throw new HttpError(404, 'cart item not found');
  const d = validate({ quantity: cartFields.quantity, size: cartFields.size }, body, true);
  const next = { ...line, ...d };
  const twin = carts.items.find(
    (c) => c.id !== line.id && c.userId === next.userId && c.productId === next.productId && c.size === next.size
  );
  if (twin) {

    if (twin.quantity + next.quantity > 99) throw new HttpError(400, 'quantity cannot exceed 99');
    const { id, createdAt, updatedAt, ...rest } = twin;
    carts.replace(id, { ...rest, quantity: twin.quantity + next.quantity });
    carts.remove(line.id);
  } else {
    const { id, createdAt, updatedAt, ...rest } = next;
    carts.replace(id, rest);
  }
  return [200, cartView(line.userId)];
});

route('DELETE', '/cart/:id', ({ params }) => {
  const line = carts.find(parseId(params.id));
  if (!line) throw new HttpError(404, 'cart item not found');
  carts.remove(line.id);
  return [200, cartView(line.userId)];
});

route('DELETE', '/cart', ({ query }) => {
  const userId = cartUserId(query);
  carts.removeWhere((c) => c.userId === userId);
  return [200, cartView(userId)];
});

const PAYMENTS = ['Cash on Delivery', 'Credit / Debit Card', 'Bank Transfer'];
const STATUSES = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
const shippingFields = {
  firstName: str(true),
  lastName: str(true),
  email: email(true),
  address: str(true),
  city: str(true),
  postalCode: str(true),
  paymentMethod: oneOf(true, PAYMENTS, 'Cash on Delivery'),
};

route('POST', '/orders', ({ body }) => {
  const d = validate({ userId: ref(true, 'users'), ...shippingFields }, body, false);
  const lines = cartView(d.userId).items;
  if (!lines.length) throw new HttpError(400, 'Cart is empty');
  const items = lines.map(({ productId, name, price, size, quantity, lineTotal }) => ({
    productId, name, price, size, quantity, lineTotal,
  }));
  const order = orders.insert({ ...d, items, ...totals(lines), status: 'pending' });
  carts.removeWhere((c) => c.userId === d.userId);
  return [201, order];
});

route('GET', '/orders', ({ query }) => {
  let list = orders.items;
  for (const f of ['userId', 'status']) {
    const q = query.get(f);
    if (q !== null) list = list.filter((o) => String(o[f]) === q);
  }
  return [200, list];
});

const orderOr404 = (rawId) => {
  const order = orders.find(parseId(rawId));
  if (!order) throw new HttpError(404, 'order not found');
  return order;
};
route('GET', '/orders/:id', ({ params }) => [200, orderOr404(params.id)]);
route('PATCH', '/orders/:id', ({ params, body }) => {
  const order = orderOr404(params.id);
  const d = validate({ ...shippingFields, status: oneOf(false, STATUSES) }, body, true);
  const { id, createdAt, updatedAt, ...rest } = order;
  return [200, orders.replace(id, { ...rest, ...d })];
});
route('DELETE', '/orders/:id', ({ params }) => {
  const order = orderOr404(params.id);
  orders.remove(order.id);
  return [200, { deleted: order }];
});

const server = http.createServer(async (req, res) => {
  const send = (status, body) => {
    res.writeHead(status, {
      'Content-Type': 'application/json',
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET,POST,PUT,PATCH,DELETE,OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type',
    });
    res.end(JSON.stringify(body));
  };

  try {
    if (req.method === 'OPTIONS') return send(204, {});
    const url = new URL(req.url, 'http://localhost');

    if (url.pathname === '/') {
      return send(200, {
        message: 'SoleStep API',
        endpoints: ['/products', '/reviews', '/signup', '/login', '/users', '/cart', '/orders'],
      });
    }

    let pathMatched = false;
    for (const r of routes) {
      const m = r.re.exec(url.pathname);
      if (!m) continue;
      pathMatched = true;
      if (r.method !== req.method) continue;
      const params = {};
      r.keys.forEach((k, i) => (params[k] = decodeURIComponent(m[i + 1])));
      const body = ['POST', 'PUT', 'PATCH'].includes(req.method) ? await readJson(req) : undefined;
      const [status, payload] = await r.handler({ params, query: url.searchParams, body });
      return send(status, payload);
    }
    throw new HttpError(pathMatched ? 405 : 404, pathMatched ? 'Method not allowed' : 'Not found');
  } catch (error) {
    if (error instanceof HttpError) return send(error.status, { error: error.message });
    console.error(error);
    send(500, { error: 'Server error' });
  }
});

