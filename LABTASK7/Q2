const str = (required = false, def) => ({
  required,
  default: def,
  parse(v) {
    if (typeof v !== 'string' || !v.trim()) throw 'must be a non-empty string';
    return v.trim();
  },
});
const num = (required, min, max, { integer = false, def } = {}) => ({
  required,
  default: def,
  parse(v) {
    if (typeof v !== 'number' || !Number.isFinite(v)) throw 'must be a number';
    if (integer && !Number.isInteger(v)) throw 'must be an integer';
    if (v < min || v > max) throw `must be between ${min} and ${max}`;
    return v;
  },
});
const bool = (def) => ({
  required: false,
  default: def,
  parse(v) {
    if (typeof v !== 'boolean') throw 'must be true or false';
    return v;
  },
});
const oneOf = (required, values, def) => ({
  required,
  default: def,
  parse(v) {
    if (!values.includes(v)) throw `must be one of: ${values.join(', ')}`;
    return v;
  },
});
const ref = (required, collection) => ({
  required,
  parse(v) {
    if (!Number.isInteger(v)) throw 'must be an integer id';
    if (!stores[collection].find(v)) throw `no ${collection.slice(0, -1)} with id ${v}`;
    return v;
  },
});
const email = (required) => ({
  required,
  parse(v) {
    if (typeof v !== 'string' || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())) throw 'must be a valid email';
    return v.trim().toLowerCase();
  },
});
const password = {
  required: true,
  parse(v) {
    if (typeof v !== 'string' || v.length < 6) throw 'must be at least 6 characters';
    return v;
  },
};

function validate(fields, body, partial) {
  if (body === null || typeof body !== 'object' || Array.isArray(body)) {
    throw new HttpError(400, 'Body must be a JSON object');
  }
  const errors = [];
  const data = {};
  for (const [key, rule] of Object.entries(fields)) {
    const value = body[key];
    if (value === undefined) {
      if (partial) continue;
      if (rule.default !== undefined) data[key] = rule.default;
      else if (rule.required) errors.push(`${key} is required`);
      continue;
    }
    try {
      data[key] = rule.parse(value);
    } catch (msg) {
      if (typeof msg !== 'string') throw msg;
      errors.push(`${key} ${msg}`);
    }
  }
  if (errors.length) throw new HttpError(400, errors.join('; '));
  return data;
}

const routes = [];
const route = (method, pattern, handler) => {
  const keys = [];
  const re = new RegExp(`^${pattern.replace(/:(\w+)/g, (_, k) => (keys.push(k), '([^/]+)'))}/?$`);
  routes.push({ method, re, keys, handler });
};

const parseId = (raw) => {
  const id = Number(raw);
  if (!Number.isInteger(id)) throw new HttpError(400, 'id must be an integer');
  return id;
};

async function readJson(req) {
  let raw = '';
  for await (const chunk of req) {
    raw += chunk;
    if (Buffer.byteLength(raw) > 65536) throw new HttpError(413, 'Too large');
  }
  if (!raw.trim()) return {};
  try {
    return JSON.parse(raw);
  } catch {
    throw new HttpError(400, 'Invalid JSON');
  }
}

function crud(base, label, store, def) {
  const out = def.out || ((r) => r);
  const getOr404 = (rawId) => {
    const id = parseId(rawId);
    const rec = store.find(id);
    if (!rec) throw new HttpError(404, `${label} ${id} not found`);
    return rec;
  };

  route('GET', `/${base}`, ({ query }) => {
    let list = store.items;
    for (const f of def.filters || []) {
      const q = query.get(f);
      if (q !== null) list = list.filter((x) => String(x[f]).toLowerCase() === q.toLowerCase());
    }
    const q = query.get('q');
    if (q && def.search) {
      list = list.filter((x) => def.search.some((f) => String(x[f] ?? '').toLowerCase().includes(q.toLowerCase())));
    }
    return [200, list.map(out)];
  });
  route('GET', `/${base}/:id`, ({ params }) => [200, out(getOr404(params.id))]);
  route('POST', `/${base}`, ({ body }) => [201, out(store.insert(validate(def.fields, body, false)))]);
  route('PUT', `/${base}/:id`, ({ params, body }) => {
    const cur = getOr404(params.id);
    return [200, out(store.replace(cur.id, validate(def.fields, body, false)))];
  });
  route('PATCH', `/${base}/:id`, ({ params, body }) => {
    const cur = getOr404(params.id);
    const { id, createdAt, updatedAt, ...rest } = cur;
    return [200, out(store.replace(id, { ...rest, ...validate(def.fields, body, true) }))];
  });
  route('DELETE', `/${base}/:id`, ({ params }) => {
    const cur = getOr404(params.id);
    store.remove(cur.id);
    if (def.afterDelete) def.afterDelete(cur.id);
    return [200, { deleted: out(cur) }];
  });
}

const SHIPPING_CENTS = 1000;
const cents = (n) => Math.round(n * 100);
function totals(lines) {
  const sub = lines.reduce((sum, l) => sum + cents(l.price) * l.quantity, 0);
  const ship = lines.length ? SHIPPING_CENTS : 0;
  return { subtotal: sub / 100, shipping: ship / 100, total: (sub + ship) / 100 };
}

