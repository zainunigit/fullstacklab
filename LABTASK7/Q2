class HttpError extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

class Store {
  constructor(name, seed = []) {
    this.file = path.join(DATA_DIR, `${name}.json`);
    this.items = [];
    this.nextId = 1;
    if (fs.existsSync(this.file)) {
      const saved = JSON.parse(fs.readFileSync(this.file, 'utf8'));
      this.items = saved.items;
      this.nextId = saved.nextId;
    } else {
      for (const s of seed) this.insert(s, false);
      this.save();
    }
  }

  save() {
    const tmp = `${this.file}.tmp`;
    fs.writeFileSync(tmp, JSON.stringify({ nextId: this.nextId, items: this.items }, null, 2));
    fs.renameSync(tmp, this.file);
  }
  find(id) {
    return this.items.find((x) => x.id === id);
  }
  insert(data, persist = true) {
    const record = { id: this.nextId++, ...data, createdAt: new Date().toISOString() };
    this.items.push(record);
    if (persist) this.save();
    return record;
  }
  replace(id, data) {
    const i = this.items.findIndex((x) => x.id === id);
    const cur = this.items[i];
    this.items[i] = { id, ...data, createdAt: cur.createdAt, updatedAt: new Date().toISOString() };
    this.save();
    return this.items[i];
  }
  remove(id) {
    const i = this.items.findIndex((x) => x.id === id);
    const [gone] = this.items.splice(i, 1);
    this.save();
    return gone;
  }
  removeWhere(pred) {
    const before = this.items.length;
    this.items = this.items.filter((x) => !pred(x));
    if (this.items.length !== before) this.save();
  }
}

